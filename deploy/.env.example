# Copy to .env next to docker-compose.yml and fill in. .env is not committed.
# docker compose reads this file twice: for ${...} in docker-compose.yml and as the container env.

# Image tag: latest is the newest build, build-N pins a specific build (rollback).
IMAGE_TAG=latest
# Host port Vikunja is published on.
VIKUNJA_PORT=3456

# URL you open Vikunja at, with a trailing slash: http://<server IP>:<VIKUNJA_PORT>/
VIKUNJA_SERVICE_PUBLICURL=
# Required. Long random string that never changes, e.g. the output of: openssl rand -hex 32
# Left empty, Vikunja generates a new one on every start and all sessions are logged out.
VIKUNJA_SERVICE_SECRET=
VIKUNJA_SERVICE_TIMEZONE=Europe/Moscow
VIKUNJA_SERVICE_ENABLEREGISTRATION=false
VIKUNJA_DEFAULTSETTINGS_LANGUAGE=ru-RU
VIKUNJA_DEFAULTSETTINGS_WEEK_START=1
VIKUNJA_DEFAULTSETTINGS_AVATAR_PROVIDER=initials
